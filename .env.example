# Sanic API
CHESS_WORKBENCH_HOST=127.0.0.1
CHESS_WORKBENCH_PORT=8000
CHESS_WORKBENCH_DEBUG=false
CHESS_WORKBENCH_DATABASE_URL=sqlite+aiosqlite:///./data/database/chess-workbench.db

# Stage 6 local analysis. `make install-stockfish` installs the pinned default.
CHESS_WORKBENCH_STOCKFISH_PATH=./data/engines/stockfish-18/stockfish
CHESS_WORKBENCH_SYZYGY_PATH=./data/tablebases/syzygy
CHESS_WORKBENCH_ENGINE_MAX_THREADS=4
CHESS_WORKBENCH_ENGINE_MAX_HASH_MB=1024
CHESS_WORKBENCH_ENGINE_MAX_TIME_MS=30000
CHESS_WORKBENCH_ENGINE_WORKER_ENABLED=true
# Independent PDF jobs and all main/repair model calls share bounded slots.
CHESS_WORKBENCH_PDF_WORKER_CONCURRENCY=2
CHESS_WORKBENCH_CCEF_PROVIDER_CONCURRENCY=2
CHESS_WORKBENCH_CCEF_PROVIDER_TOTAL_TIMEOUT_SECONDS=1800

# Vite development proxy. The browser still calls the same-origin /api path.
CHESS_WORKBENCH_API_PROXY_TARGET=http://127.0.0.1:8000

# Stage 8C AI extraction is optional. Provider-specific values belong only in
# your ignored local .env. Store the key itself outside this Git repository in
# a chmod 600 regular file; .env contains only its path.
# CHESS_WORKBENCH_CCEF_PROVIDER_ENDPOINT=https://provider.example/v1/chat/completions
# CHESS_WORKBENCH_CCEF_PROVIDER_MODEL=provider-model-id
# CHESS_WORKBENCH_CCEF_PROVIDER_API_KEY_FILE=/home/your-user/.config/chess-workbench/provider-api-key
CHESS_WORKBENCH_CCEF_PROVIDER_TIMEOUT_SECONDS=600
# Thinking intensity for main extraction; bounded non-thinking repair ignores it.
CHESS_WORKBENCH_CCEF_PROVIDER_REASONING_EFFORT=max
# Independent bounded recovery profile; optional model uses the same endpoint/key.
# CHESS_WORKBENCH_CCEF_RECOVERY_MODEL=provider-repair-model-id
CHESS_WORKBENCH_CCEF_RECOVERY_REASONING_EFFORT=none
CHESS_WORKBENCH_CCEF_RECOVERY_JSON_OUTPUT=true
CHESS_WORKBENCH_CCEF_MAX_OUTPUT_TOKENS=128000
CHESS_WORKBENCH_CCEF_MAX_PROMPT_CHARS=2000000

# Optional one-way course export to Lichess. The file contains a personal token
# with study:write scope. Keep it outside the repo with chmod 600.
# CHESS_WORKBENCH_LICHESS_API_TOKEN_FILE=/home/your-user/.config/chess-workbench/lichess-token
