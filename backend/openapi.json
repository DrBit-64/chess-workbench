{
  "info": {
    "contact": {},
    "description": "Authoritative HTTP API for ChessWorkbench.",
    "title": "ChessWorkbench API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "description": "Successful health contract shared with the frontend through OpenAPI.",
                  "properties": {
                    "database": {
                      "default": "ok",
                      "enum": [
                        "ok"
                      ],
                      "title": "Database",
                      "type": "string"
                    },
                    "service": {
                      "title": "Service",
                      "type": "string"
                    },
                    "status": {
                      "default": "ok",
                      "enum": [
                        "ok"
                      ],
                      "title": "Status",
                      "type": "string"
                    },
                    "version": {
                      "title": "Version",
                      "type": "string"
                    }
                  },
                  "required": [
                    "service",
                    "version"
                  ],
                  "title": "HealthResponse",
                  "type": "object"
                }
              }
            },
            "description": "API and database are healthy"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "description": "Health contract returned when the database round trip fails.",
                  "properties": {
                    "database": {
                      "default": "error",
                      "enum": [
                        "error"
                      ],
                      "title": "Database",
                      "type": "string"
                    },
                    "service": {
                      "title": "Service",
                      "type": "string"
                    },
                    "status": {
                      "default": "error",
                      "enum": [
                        "error"
                      ],
                      "title": "Status",
                      "type": "string"
                    },
                    "version": {
                      "title": "Version",
                      "type": "string"
                    }
                  },
                  "required": [
                    "service",
                    "version"
                  ],
                  "title": "UnhealthyResponse",
                  "type": "object"
                }
              }
            },
            "description": "Database is unavailable"
          }
        },
        "summary": "Check API and database health",
        "tags": [
          "system"
        ]
      }
    }
  },
  "security": [],
  "servers": [],
  "tags": [
    {
      "name": "system"
    }
  ]
}
